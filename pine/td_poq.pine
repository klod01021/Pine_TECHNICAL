// TD POQ (Price Oscillator Qualifier) — Tom DeMark
//@version=6
indicator("TD POQ", shorttitle="TD POQ", overlay=false)

fast = input.int(3, "Fast EMA", minval=1)
slow = input.int(8, "Slow EMA", minval=1)

fastEma = ta.ema(close, fast)
slowEma = ta.ema(close, slow)

poq = slowEma == 0.0 ? 0.0 : 100.0 * (fastEma - slowEma) / slowEma

plot(poq, "POQ", color=color.new(color.blue, 0), linewidth=2)
hline(0, "Zero", color=color.new(color.gray, 60))

// POQ above zero confirms an upside breakout, below zero a downside one.
bgcolor(poq > 0 ? color.new(color.green, 92) : color.new(color.red, 92))
