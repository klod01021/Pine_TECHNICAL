// TD Setup Trend (TDST) — support/resistance from completed setups
//@version=6
indicator("TD Setup Trend (TDST)", shorttitle="TDST", overlay=true, timeframe="", timeframe_gaps=true)

setupLen = input.int(9, "Setup Length", minval=1)
cmp = input.int(4, "Comparison Bars", minval=1)

// --- TD Setup -------------------------------------------------------------
var int buySetup = 0
var int sellSetup = 0
if close < close[cmp]
    buySetup += 1
    sellSetup := 0
else if close > close[cmp]
    sellSetup += 1
    buySetup := 0

if buySetup > setupLen
    buySetup := 1
if sellSetup > setupLen
    sellSetup := 1

// --- TDST levels ------------------------------------------------------------
var float support = na
var float resistance = na

if buySetup == setupLen
    support := ta.lowest(low, setupLen)
if sellSetup == setupLen
    resistance := ta.highest(high, setupLen)

supportBroken = false
resistanceBroken = false

if not na(support) and close < support
    supportBroken := true
    support := na
if not na(resistance) and close > resistance
    resistanceBroken := true
    resistance := na

plot(support, "TDST Support", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)
plot(resistance, "TDST Resistance", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)

plotshape(supportBroken, "Support Broken", style=shape.xcross, location=location.belowbar, color=color.red, size=size.tiny)
plotshape(resistanceBroken, "Resistance Broken", style=shape.xcross, location=location.abovebar, color=color.green, size=size.tiny)

alertcondition(supportBroken, "TDST Support Broken", "Price closed below TDST support")
alertcondition(resistanceBroken, "TDST Resistance Broken", "Price closed above TDST resistance")
