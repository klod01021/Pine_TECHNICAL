// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// DeMark Oscillator Suite — DeMarker, DeMarker II, TD Pressure Ratio, TD REI,
// TD POQ, TD Alignment, TD ROC and TD Oscillator on one pane.
//
// The oscillators use different scales, so unbounded ones are rescaled to the
// same 0-100 band for shape comparison. The "focus" dropdown picks which one
// drives the overbought / oversold shading.
//@version=6
indicator("DeMark Oscillator Suite", shorttitle="DeM Oscillators", overlay=false, timeframe="", timeframe_gaps=true)

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------
focus = input.string("DeMarker", "Focus oscillator", options=["DeMarker", "DeMarker II", "TD Pressure Ratio", "TD REI", "TD POQ", "TD Alignment", "TD ROC", "TD Oscillator"], group="Display")
scaleLookback = input.int(200, "Rescale lookback for unbounded oscillators", minval=10, group="Display")
obLevel = input.float(70.0, "Overbought", group="Display")
osLevel = input.float(30.0, "Oversold", group="Display")

showDem = input.bool(true, "DeMarker", inline="o1", group="Oscillators")
demLen = input.int(14, "len", minval=1, inline="o1", group="Oscillators")
showDem2 = input.bool(false, "DeMarker II", inline="o2", group="Oscillators")
dem2Len = input.int(8, "len", minval=1, inline="o2", group="Oscillators")
showPr = input.bool(false, "TD Pressure Ratio", inline="o3", group="Oscillators")
prLen = input.int(13, "len", minval=1, inline="o3", group="Oscillators")
showRei = input.bool(false, "TD REI", inline="o4", group="Oscillators")
reiLen = input.int(5, "len", minval=1, inline="o4", group="Oscillators")
showPoq = input.bool(false, "TD POQ", inline="o5", group="Oscillators")
poqFast = input.int(3, "fast", minval=1, inline="o5", group="Oscillators")
poqSlow = input.int(8, "slow", minval=1, inline="o5", group="Oscillators")
showAlign = input.bool(false, "TD Alignment", inline="o6", group="Oscillators")
alFast = input.int(5, "fast", minval=1, inline="o6", group="Oscillators")
alSlow = input.int(13, "slow", minval=1, inline="o6", group="Oscillators")
alSignalLen = input.int(8, "signal", minval=1, inline="o6", group="Oscillators")
showRoc = input.bool(false, "TD ROC", inline="o7", group="Oscillators")
rocLen = input.int(5, "len", minval=1, inline="o7", group="Oscillators")
rocSignalLen = input.int(8, "signal", minval=1, inline="o7", group="Oscillators")
showOsc = input.bool(false, "TD Oscillator", inline="o8", group="Oscillators")
oscFast = input.int(3, "fast", minval=1, inline="o8", group="Oscillators")
oscSlow = input.int(9, "slow", minval=1, inline="o8", group="Oscillators")

// ---------------------------------------------------------------------------
// DeMarker
// ---------------------------------------------------------------------------
demHigh = math.max(high - high[1], 0.0)
demLow = math.max(low[1] - low, 0.0)
demSumH = ta.sma(demHigh, demLen)
demSumL = ta.sma(demLow, demLen)
dem = (demSumH + demSumL) == 0.0 ? 0.0 : 100.0 * demSumH / (demSumH + demSumL)

// ---------------------------------------------------------------------------
// DeMarker II
// ---------------------------------------------------------------------------
midpoint = (high + low) / 2.0
up2 = math.max(high - midpoint, 0.0) * (close >= midpoint ? 1.0 : 0.0)
dn2 = math.max(midpoint - low, 0.0) * (close < midpoint ? 1.0 : 0.0)
sumUp2 = ta.sma(up2, dem2Len)
sumDn2 = ta.sma(dn2, dem2Len)
dem2 = (sumUp2 + sumDn2) == 0.0 ? 0.0 : 100.0 * sumUp2 / (sumUp2 + sumDn2)

// ---------------------------------------------------------------------------
// TD Pressure Ratio
// ---------------------------------------------------------------------------
trueRange = math.max(math.max(high - low, math.abs(high - close[1])), math.abs(low - close[1]))
buying = math.max(close - low, 0.0) * trueRange
selling = math.max(high - close, 0.0) * trueRange
sumBuy = ta.sma(buying, prLen)
sumSell = ta.sma(selling, prLen)
prRatio = (sumBuy + sumSell) == 0.0 ? 0.0 : 100.0 * sumBuy / (sumBuy + sumSell)

// ---------------------------------------------------------------------------
// TD Range Expansion Index (DeMark's published formula)
// A bar contributes (high - high[2]) + (low - low[2]) only when one of two
// filters holds; otherwise it adds nothing to numerator or denominator.
// ---------------------------------------------------------------------------
condA = (high >= low[5] or high >= low[6]) and (low <= high[5] or low <= high[6])
condB = (high[2] >= close[7] or high[2] >= close[8]) and (low[2] <= close[7] or low[2] <= close[8])
reiQualified = (condA or condB) and not na(close[8])
dh = high - high[2]
dl = low - low[2]
reiValue = reiQualified ? dh + dl : 0.0
reiAbs = reiQualified ? math.abs(dh) + math.abs(dl) : 0.0
reiNum = math.sum(reiValue, reiLen)
reiDen = math.sum(reiAbs, reiLen)
rei = reiDen == 0.0 ? 0.0 : 100.0 * reiNum / reiDen

// ---------------------------------------------------------------------------
// TD POQ / Alignment / ROC / Oscillator
// ---------------------------------------------------------------------------
poqFastEma = ta.ema(close, poqFast)
poqSlowEma = ta.ema(close, poqSlow)
poq = poqSlowEma == 0.0 ? 0.0 : 100.0 * (poqFastEma - poqSlowEma) / poqSlowEma

alFastMa = ta.sma(close, alFast)
alSlowMa = ta.sma(close, alSlow)
alignment = alSlowMa == 0.0 ? 0.0 : 100.0 * (alFastMa - alSlowMa) / alSlowMa
alignSignal = ta.ema(alignment, alSignalLen)

roc = close[rocLen] == 0.0 ? 0.0 : 100.0 * (close - close[rocLen]) / close[rocLen]
rocSignal = ta.ema(roc, rocSignalLen)

oscFastMa = ta.sma(close, oscFast)
oscSlowMa = ta.sma(close, oscSlow)
tdOsc = oscSlowMa == 0.0 ? 0.0 : 100.0 * (oscFastMa - oscSlowMa) / oscSlowMa

// ---------------------------------------------------------------------------
// Rescale unbounded oscillators onto the shared 0-100 band.
//
// These are written out rather than wrapped in a helper on purpose: a user
// function's parameters are typed `series int`, while ta.lowest/ta.highest
// require a `simple int` length, so passing the lookback into a function does
// not compile. Calling them at global scope also guarantees they evaluate on
// every bar, which stateful ta.* functions require.
// ---------------------------------------------------------------------------
reiN = (rei + 100.0) / 2.0            // -100..100 maps directly onto 0..100

poqLo = ta.lowest(poq, scaleLookback)
poqHi = ta.highest(poq, scaleLookback)
poqN = (poqHi - poqLo) == 0.0 ? 50.0 : 100.0 * (poq - poqLo) / (poqHi - poqLo)

alignLo = ta.lowest(alignment, scaleLookback)
alignHi = ta.highest(alignment, scaleLookback)
alignN = (alignHi - alignLo) == 0.0 ? 50.0 : 100.0 * (alignment - alignLo) / (alignHi - alignLo)
// The signal line is scaled with the oscillator's own range so the crossings
// stay in the same places after rescaling.
alignSignalN = (alignHi - alignLo) == 0.0 ? 50.0 : 100.0 * (alignSignal - alignLo) / (alignHi - alignLo)

rocLo = ta.lowest(roc, scaleLookback)
rocHi = ta.highest(roc, scaleLookback)
rocN = (rocHi - rocLo) == 0.0 ? 50.0 : 100.0 * (roc - rocLo) / (rocHi - rocLo)
rocSignalN = (rocHi - rocLo) == 0.0 ? 50.0 : 100.0 * (rocSignal - rocLo) / (rocHi - rocLo)

oscLo = ta.lowest(tdOsc, scaleLookback)
oscHi = ta.highest(tdOsc, scaleLookback)
oscN = (oscHi - oscLo) == 0.0 ? 50.0 : 100.0 * (tdOsc - oscLo) / (oscHi - oscLo)

// Raw value of the focus oscillator, for the data window and shading.
focusRaw = switch focus
    "DeMarker" => dem
    "DeMarker II" => dem2
    "TD Pressure Ratio" => prRatio
    "TD REI" => rei
    "TD POQ" => poq
    "TD Alignment" => alignment
    "TD ROC" => roc
    => tdOsc

focusIsBounded = focus == "DeMarker" or focus == "DeMarker II" or focus == "TD Pressure Ratio"

// ---------------------------------------------------------------------------
// Plots
// ---------------------------------------------------------------------------
plot(showDem ? dem : na, "DeMarker", color=color.new(color.blue, 0), linewidth=2)
plot(showDem2 ? dem2 : na, "DeMarker II", color=color.new(color.navy, 0))
plot(showPr ? prRatio : na, "TD Pressure Ratio", color=color.new(color.purple, 0))
plot(showRei ? reiN : na, "TD REI (0-100 scaled)", color=color.new(color.teal, 0))
plot(showPoq ? poqN : na, "TD POQ (scaled)", color=color.new(color.orange, 0))
plot(showAlign ? alignN : na, "TD Alignment (scaled)", color=color.new(color.fuchsia, 0))
plot(showAlign ? alignSignalN : na, "TD Alignment signal", color=color.new(color.fuchsia, 55), style=plot.style_line)
plot(showRoc ? rocN : na, "TD ROC (scaled)", color=color.new(color.maroon, 0))
plot(showRoc ? rocSignalN : na, "TD ROC signal", color=color.new(color.maroon, 55), style=plot.style_line)
plot(showOsc ? oscN : na, "TD Oscillator (scaled)", color=color.new(color.gray, 0))

// Raw focus value is display=none so it shows in the data window without
// distorting the pane scale.
plot(focusRaw, "Focus (raw value)", color=color.new(color.white, 100), display=display.data_window)

hline(50, "Mid", color=color.new(color.gray, 70))
plot(obLevel, "Overbought", color=color.new(color.red, 50))
plot(osLevel, "Oversold", color=color.new(color.green, 50))

bgcolor(focusIsBounded and focusRaw > obLevel ? color.new(color.red, 92) : focusIsBounded and focusRaw < osLevel ? color.new(color.green, 92) : na)

// ---------------------------------------------------------------------------
// Signals — evaluated on the raw (unscaled) series so rescaling cannot move
// a crossing.
// ---------------------------------------------------------------------------
alignBull = showAlign and ta.crossover(alignment, alignSignal)
alignBear = showAlign and ta.crossunder(alignment, alignSignal)
rocBull = showRoc and ta.crossover(roc, rocSignal)
rocBear = showRoc and ta.crossunder(roc, rocSignal)
oscBull = showOsc and ta.crossover(tdOsc, 0.0)
oscBear = showOsc and ta.crossunder(tdOsc, 0.0)

plotshape(alignBull or rocBull or oscBull, "Bullish cross", style=shape.triangleup, location=location.bottom, color=color.new(color.green, 0), size=size.tiny)
plotshape(alignBear or rocBear or oscBear, "Bearish cross", style=shape.triangledown, location=location.top, color=color.new(color.red, 0), size=size.tiny)

// TD REI uses its own +/-45 thresholds rather than the 70/30 band, plus
// DeMark's duration test: a reading holding beyond `reiDurationBars` describes
// a trending market rather than an exhausted one.
reiDurationBars = input.int(6, "TD REI bars beyond threshold before 'severe'", minval=1, group="Display")
var int reiBarsOver = 0
var int reiBarsUnder = 0
reiBarsOver := rei > 45.0 ? reiBarsOver + 1 : 0
reiBarsUnder := rei < -45.0 ? reiBarsUnder + 1 : 0
reiSevere = showRei and (reiBarsOver > reiDurationBars or reiBarsUnder > reiDurationBars)
bgcolor(reiSevere ? color.new(color.orange, 88) : na)

alertcondition(showRei and rei > 45.0, "TD REI Overbought", "TD REI above +45")
alertcondition(showRei and rei < -45.0, "TD REI Oversold", "TD REI below -45")
alertcondition(alignBull, "TD Alignment bullish", "TD Alignment crossed above its signal")
alertcondition(alignBear, "TD Alignment bearish", "TD Alignment crossed below its signal")
alertcondition(rocBull, "TD ROC bullish", "TD ROC crossed above its signal")
alertcondition(rocBear, "TD ROC bearish", "TD ROC crossed below its signal")
