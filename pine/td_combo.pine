// TD Combo Countdown — Tom DeMark
//@version=6
indicator("TD Combo", shorttitle="TD Combo", overlay=true, timeframe="", timeframe_gaps=true, max_labels_count=500)

setupLen = input.int(9, "Setup Length", minval=1)
cdLen = input.int(13, "Combo Countdown Length", minval=1)
cmp = input.int(4, "Comparison Bars", minval=1)

// --- TD Setup -------------------------------------------------------------
var int buySetup = 0
var int sellSetup = 0
if close < close[cmp]
    buySetup += 1
    sellSetup := 0
else if close > close[cmp]
    sellSetup += 1
    buySetup := 0

if buySetup > setupLen
    buySetup := 1
if sellSetup > setupLen
    sellSetup := 1

// --- Combo Countdown -------------------------------------------------------
// Stricter than classic: every bar must qualify AND make a lower low (buy)
// or higher high (sell) than the previous combo bar.
var int buyCd = 0
var int sellCd = 0
var bool buyActive = false
var bool sellActive = false
var float lastBuyLow = na
var float lastSellHigh = na

if buySetup == setupLen
    buyActive := true
    buyCd := 0
    lastBuyLow := na
if sellSetup == setupLen
    sellActive := true
    sellCd := 0
    lastSellHigh := na

buySig = false
sellSig = false

if buyActive and bar_index >= 2 and close <= low[2] and (na(lastBuyLow) or low < lastBuyLow)
    buyCd += 1
    lastBuyLow := low
    if buyCd == cdLen
        buySig := true
        buyActive := false

if sellActive and bar_index >= 2 and close >= high[2] and (na(lastSellHigh) or high > lastSellHigh)
    sellCd += 1
    lastSellHigh := high
    if sellCd == cdLen
        sellSig := true
        sellActive := false

plotshape(buySetup == setupLen, "Buy 9", style=shape.labelup, location=location.belowbar, color=color.green, text="9", textcolor=color.white, size=size.tiny)
plotshape(sellSetup == setupLen, "Sell 9", style=shape.labeldown, location=location.abovebar, color=color.red, text="9", textcolor=color.white, size=size.tiny)
plotshape(buySig, "Combo Buy 13", style=shape.diamond, location=location.belowbar, color=color.aqua, size=size.small)
plotshape(sellSig, "Combo Sell 13", style=shape.diamond, location=location.abovebar, color=color.fuchsia, size=size.small)

alertcondition(buySig, "TD Combo Buy 13", "TD Combo buy countdown completed")
alertcondition(sellSig, "TD Combo Sell 13", "TD Combo sell countdown completed")
