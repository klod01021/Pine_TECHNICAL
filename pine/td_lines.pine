// TD Lines — Supply/Demand lines from TD Points (levels 1-3)
//@version=6
indicator("TD Lines (Supply/Demand)", shorttitle="TD Lines", overlay=true, max_lines_count=500)

left = input.int(3, "TD Point Left Bars", minval=1)
right = input.int(3, "TD Point Right Bars", minval=1)
projectBars = input.int(20, "Project lines forward (bars)", minval=0, maxval=200)
maxDeviationPct = input.float(15.0, "Stop projecting past this % from price", minval=1.0, maxval=100.0)

// A line extended with `extend.right` runs to infinity; when the slope is
// steep that drags the chart's auto-scale with it and squashes the candles.
// The projection is capped instead.
f_extendBars(x1, y1, x2, y2, maxBars, limitUp, limitDn) =>
    float slope = (x2 - x1) == 0 ? 0.0 : (y2 - y1) / (x2 - x1)
    float allowed = maxBars
    if slope > 0.0
        allowed := math.min(allowed, (limitUp - y2) / slope)
    else if slope < 0.0
        allowed := math.min(allowed, (limitDn - y2) / slope)
    int(math.max(0.0, math.floor(allowed)))

// --- TD Points ---------------------------------------------------------------
ph = ta.pivothigh(high, left, right)
pl = ta.pivotlow(low, left, right)

// Keep the four most recent pivots of each side (enough for levels 1-3).
var array<float> hiPrice = array.new<float>()
var array<int> hiBar = array.new<int>()
var array<float> loPrice = array.new<float>()
var array<int> loBar = array.new<int>()

if not na(ph)
    hiPrice.push(ph)
    hiBar.push(bar_index - right)
    if hiPrice.size() > 4
        hiPrice.shift()
        hiBar.shift()

if not na(pl)
    loPrice.push(pl)
    loBar.push(bar_index - right)
    if loPrice.size() > 4
        loPrice.shift()
        loBar.shift()

// Draw the active level-1 lines each time a new pivot confirms.
var line demandLine = na
var line supplyLine = na

limitUp = close * (1.0 + maxDeviationPct / 100.0)
limitDn = close * (1.0 - maxDeviationPct / 100.0)

if loPrice.size() >= 2
    line.delete(demandLine)
    int n = loPrice.size()
    int x1 = loBar.get(n - 2)
    float y1 = loPrice.get(n - 2)
    int x2 = loBar.get(n - 1)
    float y2 = loPrice.get(n - 1)
    int endX = math.max(bar_index, x2) + f_extendBars(x1, y1, x2, y2, projectBars, limitUp, limitDn)
    float endY = (x2 - x1) == 0 ? y2 : y2 + (y2 - y1) / (x2 - x1) * (endX - x2)
    demandLine := line.new(x1, y1, endX, endY, xloc=xloc.bar_index, color=color.new(color.green, 0), width=2)

if hiPrice.size() >= 2
    line.delete(supplyLine)
    int m = hiPrice.size()
    int p1 = hiBar.get(m - 2)
    float q1 = hiPrice.get(m - 2)
    int p2 = hiBar.get(m - 1)
    float q2 = hiPrice.get(m - 1)
    int endXh = math.max(bar_index, p2) + f_extendBars(p1, q1, p2, q2, projectBars, limitUp, limitDn)
    float endYh = (p2 - p1) == 0 ? q2 : q2 + (q2 - q1) / (p2 - p1) * (endXh - p2)
    supplyLine := line.new(p1, q1, endXh, endYh, xloc=xloc.bar_index, color=color.new(color.red, 0), width=2)

// Break alerts on the level-1 lines. line.get_price on an undefined line id is
// a runtime error, so read the values behind an explicit na guard.
float demandVal = na
float supplyVal = na
if not na(demandLine)
    demandVal := line.get_price(demandLine, bar_index)
if not na(supplyLine)
    supplyVal := line.get_price(supplyLine, bar_index)

demandBreak = not na(demandVal) and close < demandVal
supplyBreak = not na(supplyVal) and close > supplyVal

plotshape(demandBreak and not demandBreak[1], "Demand Break", style=shape.xcross, location=location.belowbar, color=color.red, size=size.tiny)
plotshape(supplyBreak and not supplyBreak[1], "Supply Break", style=shape.xcross, location=location.abovebar, color=color.green, size=size.tiny)

alertcondition(demandBreak, "TD Demand Line Broken", "Price closed below the TD demand line")
alertcondition(supplyBreak, "TD Supply Line Broken", "Price closed above the TD supply line")
