// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// DeMark Levels & Trend Suite — TDST, TD Lines, TD Moving Averages,
// TD Range Projection, TD Retracements and the DeMark Trendline on one chart.
// Each tool can be toggled independently.
//@version=6
indicator("DeMark Levels & Trend Suite", shorttitle="DeM Levels", overlay=true, timeframe="", timeframe_gaps=true, max_lines_count=500, max_labels_count=500)

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------
showTdst = input.bool(true, "TDST levels", group="TDST")
setupLen = input.int(9, "Setup length", minval=1, group="TDST")
cmp = input.int(4, "Comparison bars", minval=1, group="TDST")

showTdLines = input.bool(true, "TD Supply/Demand lines", group="TD Lines")
leftBars = input.int(1, "TD Point left bars", minval=1, group="TD Lines")
rightBars = input.int(1, "TD Point right bars", minval=1, group="TD Lines")
showProjection = input.bool(true, "One-bar-ahead projections", group="TD Lines")

showMa = input.bool(true, "TD MA I/II", group="TD Moving Average")
fastLen = input.int(5, "TD MA I length", minval=1, group="TD Moving Average")
slowLen = input.int(13, "TD MA II length", minval=1, group="TD Moving Average")

showRangeProj = input.bool(false, "Projected high/low", group="TD Range Projection")

showRetr = input.bool(false, "Retracement magnets", group="TD Retracements")
lookback = input.int(100, "Swing lookback", minval=2, group="TD Retracements")

// ---------------------------------------------------------------------------
// TD Setup (feeds TDST) — resets on a failed or equal comparison
// ---------------------------------------------------------------------------
var int buySetup = 0
var int sellSetup = 0

if close < close[cmp]
    buySetup := buySetup + 1
    sellSetup := 0
else if close > close[cmp]
    sellSetup := sellSetup + 1
    buySetup := 0
else
    buySetup := 0
    sellSetup := 0

if buySetup > setupLen
    buySetup := 1
if sellSetup > setupLen
    sellSetup := 1

buyComplete = buySetup == setupLen
sellComplete = sellSetup == setupLen

// ---------------------------------------------------------------------------
// TDST — a completed BUY setup defines RESISTANCE at the highest high of its
// nine bars; a completed SELL setup defines SUPPORT at the lowest low.
// ---------------------------------------------------------------------------
var float tdstResistance = na
var float tdstSupport = na

if buyComplete
    tdstResistance := ta.highest(high, setupLen)
if sellComplete
    tdstSupport := ta.lowest(low, setupLen)

resistanceBroken = not na(tdstResistance) and close > tdstResistance
supportBroken = not na(tdstSupport) and close < tdstSupport

plot(showTdst ? tdstResistance : na, "TDST Resistance", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)
plot(showTdst ? tdstSupport : na, "TDST Support", color=color.new(color.green, 0), style=plot.style_linebr, linewidth=2)
plotshape(showTdst and resistanceBroken and not resistanceBroken[1], "TDST Resistance broken", style=shape.xcross, location=location.abovebar, color=color.new(color.green, 0), size=size.tiny)
plotshape(showTdst and supportBroken and not supportBroken[1], "TDST Support broken", style=shape.xcross, location=location.belowbar, color=color.new(color.red, 0), size=size.tiny)

// ---------------------------------------------------------------------------
// TD Points -> TD Lines / DeMark Trendline (shared pivot stack)
// ---------------------------------------------------------------------------
ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low, leftBars, rightBars)

var array<float> hiPrice = array.new<float>()
var array<int> hiBar = array.new<int>()
var array<float> loPrice = array.new<float>()
var array<int> loBar = array.new<int>()

if not na(ph)
    hiPrice.push(ph)
    hiBar.push(bar_index - rightBars)
    if hiPrice.size() > 4
        hiPrice.shift()
        hiBar.shift()
if not na(pl)
    loPrice.push(pl)
    loBar.push(bar_index - rightBars)
    if loPrice.size() > 4
        loPrice.shift()
        loBar.shift()

var line demandLine = na
var line supplyLine = na

if showTdLines and loPrice.size() >= 2
    line.delete(demandLine)
    int nLo = loPrice.size()
    demandLine := line.new(loBar.get(nLo - 2), loPrice.get(nLo - 2), loBar.get(nLo - 1), loPrice.get(nLo - 1), xloc=xloc.bar_index, extend=extend.right, color=color.new(color.green, 0), width=2)

if showTdLines and hiPrice.size() >= 2
    line.delete(supplyLine)
    int nHi = hiPrice.size()
    supplyLine := line.new(hiBar.get(nHi - 2), hiPrice.get(nHi - 2), hiBar.get(nHi - 1), hiPrice.get(nHi - 1), xloc=xloc.bar_index, extend=extend.right, color=color.new(color.red, 0), width=2)

// Read the line values through explicit guards; line.get_price on an
// undefined line id is a runtime error.
float demandNow = na
float demandPrev = na
float supplyNow = na
float supplyPrev = na

if showTdLines and not na(demandLine)
    demandNow := line.get_price(demandLine, bar_index)
    demandPrev := line.get_price(demandLine, bar_index - 1)
if showTdLines and not na(supplyLine)
    supplyNow := line.get_price(supplyLine, bar_index)
    supplyPrev := line.get_price(supplyLine, bar_index - 1)

plot(showProjection and not na(demandNow) ? demandNow + (demandNow - demandPrev) : na, "Demand projection", color=color.new(color.green, 50), style=plot.style_circles, offset=1)
plot(showProjection and not na(supplyNow) ? supplyNow + (supplyNow - supplyPrev) : na, "Supply projection", color=color.new(color.red, 50), style=plot.style_circles, offset=1)

demandBreak = not na(demandNow) and close < demandNow
supplyBreak = not na(supplyNow) and close > supplyNow
plotshape(demandBreak and not demandBreak[1], "Demand line broken", style=shape.triangledown, location=location.belowbar, color=color.new(color.red, 0), size=size.tiny)
plotshape(supplyBreak and not supplyBreak[1], "Supply line broken", style=shape.triangleup, location=location.abovebar, color=color.new(color.green, 0), size=size.tiny)

// ---------------------------------------------------------------------------
// TD Moving Average I / II
// ---------------------------------------------------------------------------
ma1 = ta.sma(close, fastLen)
ma2 = ta.sma(close, slowLen)
plot(showMa ? ma1 : na, "TD MA I", color=color.new(color.blue, 0), linewidth=2)
plot(showMa ? ma2 : na, "TD MA II", color=color.new(color.orange, 0), linewidth=2)

// ---------------------------------------------------------------------------
// TD Range Projection
// ---------------------------------------------------------------------------
upBar = close >= open
projHigh = upBar ? 2.0 * high - low : 2.0 * high - close
projLow = upBar ? 2.0 * low - high : 2.0 * low - close
plot(showRangeProj ? projHigh : na, "Projected high", color=color.new(color.red, 40), style=plot.style_linebr, offset=1)
plot(showRangeProj ? projLow : na, "Projected low", color=color.new(color.green, 40), style=plot.style_linebr, offset=1)

// ---------------------------------------------------------------------------
// TD Retracements
// ---------------------------------------------------------------------------
swingHigh = ta.highest(high, lookback)
swingLow = ta.lowest(low, lookback)
swingRange = swingHigh - swingLow
plot(showRetr ? swingHigh : na, "Swing high", color=color.new(color.red, 30), style=plot.style_linebr)
plot(showRetr ? swingLow : na, "Swing low", color=color.new(color.green, 30), style=plot.style_linebr)
plot(showRetr ? swingLow + swingRange * 0.382 : na, "Up 38.2%", color=color.new(color.teal, 40), style=plot.style_linebr)
plot(showRetr ? swingLow + swingRange * 0.618 : na, "Up 61.8%", color=color.new(color.teal, 0), style=plot.style_linebr)
plot(showRetr ? swingHigh - swingRange * 0.382 : na, "Down 38.2%", color=color.new(color.orange, 40), style=plot.style_linebr)
plot(showRetr ? swingHigh - swingRange * 0.618 : na, "Down 61.8%", color=color.new(color.orange, 0), style=plot.style_linebr)

alertcondition(supportBroken and not supportBroken[1], "TDST support broken", "Price closed below TDST support")
alertcondition(resistanceBroken and not resistanceBroken[1], "TDST resistance broken", "Price closed above TDST resistance")
alertcondition(demandBreak and not demandBreak[1], "Demand line broken", "Price closed through the demand line")
alertcondition(supplyBreak and not supplyBreak[1], "Supply line broken", "Price closed through the supply line")
