// TD Combo — DeMark's stricter countdown.
//
// For counts 1..strictThrough a buy combo bar must satisfy all four
// conditions: close <= low[2], low <= low[1], close < close[1], and close
// below the previous counted combo close. Above that count only the last
// condition applies. Sell combo bars mirror this with highs.
//@version=6
indicator("TD Combo", shorttitle="TD Combo", overlay=true, max_labels_count=500)

setupLen = input.int(9, "Setup length", minval=1, group="Setup")
cmp = input.int(4, "Comparison bars", minval=1, group="Setup")

cdLen = input.int(13, "Combo countdown length", minval=2, group="Combo")
strictThrough = input.int(10, "Strict conditions apply through count", minval=1, maxval=13, group="Combo")
cancelOnOpposite = input.bool(true, "Cancel on opposite setup", group="Combo")
showCounts = input.bool(false, "Show running combo counts", group="Combo")

// --- TD Setup -------------------------------------------------------------
var int buySetup = 0
var int sellSetup = 0

if close < close[cmp]
    buySetup := buySetup + 1
    sellSetup := 0
else if close > close[cmp]
    sellSetup := sellSetup + 1
    buySetup := 0
else
    buySetup := 0
    sellSetup := 0

if buySetup > setupLen
    buySetup := 1
if sellSetup > setupLen
    sellSetup := 1

buyComplete = buySetup == setupLen
sellComplete = sellSetup == setupLen

// --- Combo Countdown -------------------------------------------------------
var int buyCombo = 0
var int sellCombo = 0
var bool buyActive = false
var bool sellActive = false
var float buyPrevClose = na
var float sellPrevClose = na

if buyComplete
    buyActive := true
    buyCombo := 0
    buyPrevClose := na
    if cancelOnOpposite
        sellActive := false
if sellComplete
    sellActive := true
    sellCombo := 0
    sellPrevClose := na
    if cancelOnOpposite
        buyActive := false

bool buy13 = false
bool sell13 = false
int buyBar = 0
int sellBar = 0

if buyActive and bar_index >= 2
    bool belowPrev = na(buyPrevClose) or close < buyPrevClose
    bool ok = buyCombo < strictThrough ? (close <= low[2] and low <= low[1] and close < close[1] and belowPrev) : belowPrev
    if ok
        buyCombo := buyCombo + 1
        buyPrevClose := close
        buyBar := buyCombo
        if buyCombo == cdLen
            buy13 := true
            buyActive := false

if sellActive and bar_index >= 2
    bool abovePrev = na(sellPrevClose) or close > sellPrevClose
    bool ok2 = sellCombo < strictThrough ? (close >= high[2] and high >= high[1] and close > close[1] and abovePrev) : abovePrev
    if ok2
        sellCombo := sellCombo + 1
        sellPrevClose := close
        sellBar := sellCombo
        if sellCombo == cdLen
            sell13 := true
            sellActive := false

// --- Plots ------------------------------------------------------------------
plotshape(buyComplete, "Buy 9", style=shape.labelup, location=location.belowbar, color=color.new(color.green, 0), text="9", textcolor=color.white, size=size.tiny)
plotshape(sellComplete, "Sell 9", style=shape.labeldown, location=location.abovebar, color=color.new(color.red, 0), text="9", textcolor=color.white, size=size.tiny)
plotshape(buy13, "Combo Buy 13", style=shape.labelup, location=location.belowbar, color=color.new(color.aqua, 0), text="C13", textcolor=color.black, size=size.small)
plotshape(sell13, "Combo Sell 13", style=shape.labeldown, location=location.abovebar, color=color.new(color.fuchsia, 0), text="C13", textcolor=color.white, size=size.small)

if showCounts and buyBar > 0 and not buy13
    label.new(bar_index, low, str.tostring(buyBar), xloc=xloc.bar_index, yloc=yloc.belowbar, style=label.style_none, textcolor=color.new(color.aqua, 20), size=size.tiny)
if showCounts and sellBar > 0 and not sell13
    label.new(bar_index, high, str.tostring(sellBar), xloc=xloc.bar_index, yloc=yloc.abovebar, style=label.style_none, textcolor=color.new(color.fuchsia, 20), size=size.tiny)

alertcondition(buy13, "TD Combo Buy 13", "TD Combo buy countdown completed")
alertcondition(sell13, "TD Combo Sell 13", "TD Combo sell countdown completed")
