//@version=6
// =============================================================================
//  DeMark TD Sequential
//  TD Price Flip -> TD Setup (1..9) -> TD Countdown (1..13) + TDST levels
//
//  Rules implemented (Tom DeMark, "The New Science of Technical Analysis"):
//
//  TD Price Flip
//    Bearish flip : close[1] > close[5] and close < close[4]  -> starts a buy setup
//    Bullish flip : close[1] < close[5] and close > close[4]  -> starts a sell setup
//
//  TD Setup (9 consecutive bars)
//    Buy setup  : every bar closes below the close four bars earlier
//    Sell setup : every bar closes above the close four bars earlier
//    A single failing bar resets the count; a new setup needs a new price flip.
//
//  Setup perfection
//    Buy  : min(low  of bars 8, 9) <= min(low  of bars 6, 7)
//    Sell : max(high of bars 8, 9) >= max(high of bars 6, 7)
//    If unmet at bar 9 the setup can still be perfected by a later bar that
//    trades through the bar 6/7 extreme (deferred perfection).
//
//  TDST levels
//    Buy setup  -> resistance at the highest true high of bars 1..9
//    Sell setup -> support    at the lowest  true low  of bars 1..9
//
//  TD Countdown (13 bars, non consecutive, armed by a completed setup)
//    Buy  : close <= low  two bars earlier
//    Sell : close >= high two bars earlier
//    Bar 13 qualifier: the low (high) of bar 13 must be at or beyond the close
//    of countdown bar 8, otherwise the bar is deferred and marked "+".
//    A completed setup in the opposite direction cancels the countdown.
//
//  Entries
//    A completed 13 is tradable either on its close (aggressive) or on the
//    first price flip after it (conservative). The stop is the risk level, the
//    extreme true low of the countdown phase less that bar's true range, and
//    the objective is TDST. Setup nine entries and their filters live in
//    demark_9_13.pine.
// =============================================================================

indicator("DeMark TD Sequential", "TD SEQ", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ------------------------------------------------------------------- inputs --
GS = "TD Setup"
GC = "TD Countdown"
GE = "Entries"
GT = "TDST Levels"
GA = "Appearance"
GD = "Chart display"

chartMode = input.string("Classic", "How much to show", options = ["Classic", "Full", "Simple", "Signals only", "Custom"], group = GD,
                          tooltip = "Classic (default): the usual DeMark look - plain 1-9 setup counts close to the bars, plain 1-13 countdown counts one row out, TDST lines, no buy/sell labels. Full: same counts plus extras. Simple: only late counts. Signals only: markers and entries, no numbers. Custom: use the settings below.")

showSetup    = input.bool(true, "Custom: show setup counts", group = GS)
minCount     = input.int(1, "Custom: start plotting setup counts at", minval = 1, maxval = 9, group = GS,
                         tooltip = "Raise to 7 or 8 to keep the chart clean and only see the end of each setup.")
showPerf     = input.bool(true, "Mark perfected setups", group = GS)
perfWindow   = input.int(8, "Bars allowed for deferred perfection", minval = 0, maxval = 50, group = GS)

showCD       = input.bool(true, "Custom: show countdown counts", group = GC)
minCDCount   = input.int(1, "Custom: start plotting countdown counts at", minval = 1, maxval = 13, group = GC)
aggressiveCD = input.bool(false, "Aggressive countdown", group = GC,
                          tooltip = "Compare the current low/high with the low/high two bars earlier instead of using the close.")
useQualifier = input.bool(true, "Apply the bar 13 qualifier", group = GC)
cancelOnTDST = input.bool(false, "Cancel countdown on a TDST break", group = GC,
                          tooltip = "A buy countdown is cancelled by a close above TDST resistance, a sell countdown by a close below TDST support.")
recycle      = input.bool(true, "Recycle countdown on a new same-direction setup", group = GC)

showTrades  = input.bool(false, "Show buy / sell entries", group = GE)
frequency   = input.string("More signals", "How many signals", options = ["DeMark strict", "More signals", "Maximum signals", "Custom"], group = GE,
                             tooltip = "DeMark strict: thirteens only, wait for a price flip. More signals: perfected nines as well, and longer to confirm. Maximum signals: nines whether perfected or not, taken on the signal bar itself. Custom: use the settings below. The looser the setting the more trades you get and the worse the average one is.")
trade13     = input.bool(true, "Custom: trade countdown 13s", group = GE)
trade9      = input.bool(false, "Custom: trade setup 9s", group = GE)
entryStyle  = input.string("Conservative", "Custom: entry timing", options = ["Aggressive", "Conservative"], group = GE,
                             tooltip = "Aggressive takes the close of the signal bar. Conservative waits for the first close beyond the close four bars earlier, which is DeMark's way of avoiding a recycle.")
confirmRule = input.string("Price flip", "Custom: confirmation", options = ["Price flip", "Any close in direction"], group = GE)
flipWindow  = input.int(12, "Custom: bars to wait for confirmation", minval = 1, maxval = 60, group = GE)
showStopTgt = input.bool(false, "Draw stop and target while in a trade", group = GE)

showTDST     = input.bool(true, "Show TDST support / resistance", group = GT)
tdstStyleIn  = input.string("Dashed", "Line style", options = ["Solid", "Dashed", "Dotted"], group = GT)
tdstWidth    = input.int(1, "Line width", minval = 1, maxval = 4, group = GT)

setupStyle   = input.string("Plain", "Setup count style", options = ["Plain", "Prefixed S", "Circled"], group = GA,
                             tooltip = "Classic DeMark charts use plain digits. Prefixed S/C or circled digits are optional.")
cdStyle      = input.string("Plain", "Countdown count style", options = ["Plain", "Prefixed C", "Circled"], group = GA)
bullCol      = input.color(#00c853, "Buy side colour", group = GA)
bearCol      = input.color(#ff1744, "Sell side colour", group = GA)
cdBullCol    = input.color(#69f0ae, "Buy countdown count colour", group = GA)
cdBearCol    = input.color(#ff8a80, "Sell countdown count colour", group = GA)
setupOff     = input.float(0.25, "Setup count row (ATR)", minval = 0, step = 0.05, group = GA)
cdOff        = input.float(0.85, "Countdown count row (ATR)", minval = 0, step = 0.05, group = GA)
entryOff     = input.float(1.6, "Entry label row (ATR)", minval = 0, step = 0.1, group = GA)

tdstStyle = tdstStyleIn == "Solid" ? line.style_solid : tdstStyleIn == "Dashed" ? line.style_dashed : line.style_dotted

classicMode = chartMode == "Classic"
signalsOnly = chartMode == "Signals only"
simpleMode  = chartMode == "Simple"
fullMode    = chartMode == "Full"
eShowSetup  = signalsOnly ? false : (classicMode or simpleMode or fullMode ? true : showSetup)
eShowCD     = signalsOnly ? false : (classicMode or simpleMode or fullMode ? true : showCD)
eMinSetup   = simpleMode ? 8 : (classicMode or fullMode ? 1 : minCount)
eMinCD      = simpleMode ? 11 : (classicMode or fullMode ? 1 : minCDCount)
eSetupStyle = classicMode ? "Plain" : (simpleMode ? "Prefixed S" : setupStyle)
eCdStyle    = classicMode ? "Plain" : (simpleMode ? "Prefixed C" : cdStyle)
eSetupOff   = classicMode ? 0.25 : setupOff
eCdOff      = classicMode ? 0.85 : cdOff
eEntryOff   = classicMode ? 1.6 : entryOff

// ---------------------------------------------------------------- utilities --
// DeMark's true high / true low also take the previous close into account.
prevClose = nz(close[1], close)
trueHigh  = math.max(high, prevClose)
trueLow   = math.min(low, prevClose)

trueRange = trueHigh - trueLow
hh9       = ta.highest(trueHigh, 9)
ll9       = ta.lowest(trueLow, 9)
atr14     = nz(ta.atr(14), high - low)

setupBuyY  = low - atr14 * eSetupOff
setupSellY = high + atr14 * eSetupOff
cdBuyY     = low - atr14 * eCdOff
cdSellY    = high + atr14 * eCdOff
entryBuyY  = low - atr14 * eEntryOff
entrySellY = high + atr14 * eEntryOff

f_count(n, style, prefix) =>
    txt = str.tostring(n)
    if style == "Circled"
        if n == 1
            txt := "①"
        else if n == 2
            txt := "②"
        else if n == 3
            txt := "③"
        else if n == 4
            txt := "④"
        else if n == 5
            txt := "⑤"
        else if n == 6
            txt := "⑥"
        else if n == 7
            txt := "⑦"
        else if n == 8
            txt := "⑧"
        else if n == 9
            txt := "⑨"
        else if n == 10
            txt := "⑩"
        else if n == 11
            txt := "⑪"
        else if n == 12
            txt := "⑫"
        else if n == 13
            txt := "⑬"
        else if n == 14
            txt := "⑭"
        else if n == 15
            txt := "⑮"
        else if n == 16
            txt := "⑯"
        else if n == 17
            txt := "⑰"
        else if n == 18
            txt := "⑱"
        else if n == 19
            txt := "⑲"
        else if n == 20
            txt := "⑳"
    else if style != "Plain"
        txt := prefix + txt
    txt

// ------------------------------------------------------------ TD Price Flip --
ready    = bar_index >= 5
buyCond  = ready and close < close[4]
sellCond = ready and close > close[4]
bearFlip = buyCond and close[1] > close[5]
bullFlip = sellCond and close[1] < close[5]

// ----------------------------------------------------------------- TD Setup --
var int buySetup  = 0
var int sellSetup = 0

buySetup  := bearFlip ? 1 : buySetup > 0 and buySetup < 9 and buyCond ? buySetup + 1 : 0
sellSetup := bullFlip ? 1 : sellSetup > 0 and sellSetup < 9 and sellCond ? sellSetup + 1 : 0

buySetupDone  = buySetup == 9
sellSetupDone = sellSetup == 9

// Extremes of the running setup, used for the risk level of a nine.
var float buySetupLo    = na
var float buySetupLoTR  = na
var float sellSetupHi   = na
var float sellSetupHiTR = na

if buySetup == 1 or (buySetup > 1 and trueLow < buySetupLo)
    buySetupLo   := trueLow
    buySetupLoTR := trueRange
if sellSetup == 1 or (sellSetup > 1 and trueHigh > sellSetupHi)
    sellSetupHi   := trueHigh
    sellSetupHiTR := trueRange

// --------------------------------------------------------------- perfection --
var float buyPerfLevel  = na
var int   buyPerfLeft   = 0
var float sellPerfLevel = na
var int   sellPerfLeft  = 0

bool buyPerfected  = false
bool sellPerfected = false

if buySetupDone
    buyPerfLevel := math.min(low[2], low[3])
    if math.min(low, low[1]) <= buyPerfLevel
        buyPerfected := true
        buyPerfLeft  := 0
    else
        buyPerfLeft := perfWindow
else if buyPerfLeft > 0
    if low <= buyPerfLevel
        buyPerfected := true
        buyPerfLeft  := 0
    else
        buyPerfLeft := buyPerfLeft - 1

if sellSetupDone
    sellPerfLevel := math.max(high[2], high[3])
    if math.max(high, high[1]) >= sellPerfLevel
        sellPerfected := true
        sellPerfLeft  := 0
    else
        sellPerfLeft := perfWindow
else if sellPerfLeft > 0
    if high >= sellPerfLevel
        sellPerfected := true
        sellPerfLeft  := 0
    else
        sellPerfLeft := sellPerfLeft - 1

// ------------------------------------------------------------- TDST levels ---
var float tdstRes   = na
var float tdstSup   = na
var bool  tdstResOn = false
var bool  tdstSupOn = false
var line  tdstResLn = na
var line  tdstSupLn = na

if buySetupDone
    tdstRes   := hh9
    tdstResOn := true
    if showTDST
        tdstResLn := line.new(bar_index - 8, tdstRes, bar_index, tdstRes, color = bearCol, style = tdstStyle, width = tdstWidth)

if sellSetupDone
    tdstSup   := ll9
    tdstSupOn := true
    if showTDST
        tdstSupLn := line.new(bar_index - 8, tdstSup, bar_index, tdstSup, color = bullCol, style = tdstStyle, width = tdstWidth)

if tdstResOn and not na(tdstResLn)
    line.set_x2(tdstResLn, bar_index)
if tdstSupOn and not na(tdstSupLn)
    line.set_x2(tdstSupLn, bar_index)

resBreak = tdstResOn and close > tdstRes
supBreak = tdstSupOn and close < tdstSup

if resBreak
    tdstResOn := false
if supBreak
    tdstSupOn := false

// ------------------------------------------------------------- TD Countdown --
var int   buyCD    = 0
var int   sellCD   = 0
var bool  buyCDOn  = false
var bool  sellCDOn = false
var float buyCD8   = na
var float sellCD8  = na
var float buyCDLo   = na   // lowest true low of the countdown phase, for the stop
var float buyCDLoTR = na
var float sellCDHi   = na
var float sellCDHiTR = na

int  buyCDPrint  = 0
int  sellCDPrint = 0
bool buyCD13     = false
bool sellCD13    = false
bool buyCDDefer  = false
bool sellCDDefer = false

// An opposite setup cancels a running countdown.
if sellSetupDone
    buyCDOn := false
    buyCD   := 0
    buyCD8  := na
if buySetupDone
    sellCDOn := false
    sellCD   := 0
    sellCD8  := na

// A completed setup arms - or recycles - the countdown in the same direction.
if buySetupDone and (not buyCDOn or recycle)
    buyCDOn   := true
    buyCD     := 0
    buyCD8    := na
    buyCDLo   := na
    buyCDLoTR := na
if sellSetupDone and (not sellCDOn or recycle)
    sellCDOn   := true
    sellCD     := 0
    sellCD8    := na
    sellCDHi   := na
    sellCDHiTR := na

// The stop comes from the most extreme bar of the countdown phase, numbered or not.
if buyCDOn and (na(buyCDLo) or trueLow < buyCDLo)
    buyCDLo   := trueLow
    buyCDLoTR := trueHigh - trueLow
if sellCDOn and (na(sellCDHi) or trueHigh > sellCDHi)
    sellCDHi   := trueHigh
    sellCDHiTR := trueHigh - trueLow

if cancelOnTDST and resBreak
    buyCDOn := false
    buyCD   := 0
    buyCD8  := na
if cancelOnTDST and supBreak
    sellCDOn := false
    sellCD   := 0
    sellCD8  := na

cdReady    = bar_index >= 2
cdBuyCond  = cdReady and (aggressiveCD ? low <= low[2] : close <= low[2])
cdSellCond = cdReady and (aggressiveCD ? high >= high[2] : close >= high[2])

if buyCDOn and cdBuyCond
    if buyCD == 12 and useQualifier and not na(buyCD8) and low > buyCD8
        buyCDDefer := true
    else
        buyCD := buyCD + 1
        buyCDPrint := buyCD
        if buyCD == 8
            buyCD8 := close
        if buyCD == 13
            buyCD13 := true
            buyCDOn := false
            buyCD   := 0
            buyCD8  := na

if sellCDOn and cdSellCond
    if sellCD == 12 and useQualifier and not na(sellCD8) and high < sellCD8
        sellCDDefer := true
    else
        sellCD := sellCD + 1
        sellCDPrint := sellCD
        if sellCD == 8
            sellCD8 := close
        if sellCD == 13
            sellCD13 := true
            sellCDOn := false
            sellCD   := 0
            sellCD8  := na

// -------------------------------------------------------- buy / sell entries --
// DeMark's two ways in: the aggressive entry on the close of the thirteen, or
// the conservative entry on the first price flip after it. The stop is the risk
// level (extreme of the countdown less that bar's true range) and the objective
// is TDST.
// The frequency preset overrides the custom settings below it. Looser settings
// trade more often and take worse entries; that is the trade, not a bug.
strictF = frequency == "DeMark strict"
moreF   = frequency == "More signals"
maxF    = frequency == "Maximum signals"
loose   = moreF or maxF

eTrade13  = loose or strictF ? true : trade13
eTrade9   = loose ? true : strictF ? false : trade9
eAggr     = maxF ? true : strictF or moreF ? false : entryStyle == "Aggressive"
eFlipWin  = strictF ? 12 : loose ? 24 : flipWindow
eAnyClose = maxF ? true : strictF or moreF ? false : confirmRule == "Any close in direction"

buy9Ok  = buySetupDone and (buyPerfected or maxF)
sell9Ok = sellSetupDone and (sellPerfected or maxF)

buySigStop  = (eTrade13 and buyCD13) ? buyCDLo - buyCDLoTR : (eTrade9 and buy9Ok) ? buySetupLo - buySetupLoTR : na
sellSigStop = (eTrade13 and sellCD13) ? sellCDHi + sellCDHiTR : (eTrade9 and sell9Ok) ? sellSetupHi + sellSetupHiTR : na

var int   pos       = 0
var float posEntry  = na
var float posStop   = na
var float posTarget = na

var bool  pendBuy      = false
var int   pendBuyBar   = na
var float pendBuyStop  = na
var bool  pendSell     = false
var int   pendSellBar  = na
var float pendSellStop = na

bool goLong   = false
bool goShort  = false
bool exitStop = false
bool exitTgt  = false

if pos == 1
    if low < posStop
        exitStop := true
        pos      := 0
    else if not na(posTarget) and high > posTarget
        exitTgt := true
        pos     := 0
else if pos == -1
    if high > posStop
        exitStop := true
        pos      := 0
    else if not na(posTarget) and low < posTarget
        exitTgt := true
        pos     := 0

float longStop  = na
float shortStop = na

confirmLong  = eAnyClose ? close > close[1] : close > close[4]
confirmShort = eAnyClose ? close < close[1] : close < close[4]

if eAggr
    if not na(buySigStop)
        longStop := buySigStop
    if not na(sellSigStop)
        shortStop := sellSigStop
else
    if not na(buySigStop)
        pendBuy     := true
        pendBuyBar  := bar_index
        pendBuyStop := buySigStop
    else if pendBuy and bar_index > pendBuyBar
        if low < pendBuyStop or bar_index - pendBuyBar > eFlipWin
            pendBuy := false
        else if confirmLong
            longStop := pendBuyStop
            pendBuy  := false
    if not na(sellSigStop)
        pendSell     := true
        pendSellBar  := bar_index
        pendSellStop := sellSigStop
    else if pendSell and bar_index > pendSellBar
        if high > pendSellStop or bar_index - pendSellBar > eFlipWin
            pendSell := false
        else if confirmShort
            shortStop := pendSellStop
            pendSell  := false

// A TDST level price has already passed is no target at all, so it is dropped.
if not na(longStop) and pos != 1 and close > longStop
    goLong    := true
    pos       := 1
    posEntry  := close
    posStop   := longStop
    posTarget := na(tdstRes) or tdstRes <= close ? na : tdstRes

if not na(shortStop) and pos != -1 and close < shortStop
    goShort   := true
    pos       := -1
    posEntry  := close
    posStop   := shortStop
    posTarget := na(tdstSup) or tdstSup >= close ? na : tdstSup

var line stopLn = na
var line tgtLn  = na

if showTrades and showStopTgt and (goLong or goShort)
    stopLn := line.new(bar_index, posStop, bar_index + 1, posStop, color = color.new(color.red, 20), style = line.style_dotted)
    tgtLn  := na(posTarget) ? na : line.new(bar_index, posTarget, bar_index + 1, posTarget, color = color.new(color.green, 20), style = line.style_dotted)

if showStopTgt and pos != 0
    if not na(stopLn)
        line.set_x2(stopLn, bar_index)
    if not na(tgtLn)
        line.set_x2(tgtLn, bar_index)

if showTrades and goLong
    label.new(bar_index, entryBuyY, "BUY " + str.tostring(posEntry, format.mintick), style = label.style_label_up, color = bullCol, textcolor = color.white, size = size.small)
if showTrades and goShort
    label.new(bar_index, entrySellY, "SELL " + str.tostring(posEntry, format.mintick), style = label.style_label_down, color = bearCol, textcolor = color.white, size = size.small)

plotshape((showTrades and exitStop) ? posStop : na, "Stopped out", shape.xcross, location.absolute, color.new(color.red, 20), size = size.tiny)
plotshape((showTrades and exitTgt) ? posTarget : na, "Target reached", shape.square, location.absolute, color.new(color.green, 20), size = size.tiny)

// ------------------------------------------------------------------ plotting --
if eShowSetup and buySetup >= eMinSetup
    label.new(bar_index, setupBuyY, f_count(buySetup, eSetupStyle, "S"), style = label.style_none, textcolor = buySetupDone ? bullCol : color.new(bullCol, 30), size = size.tiny)

if eShowSetup and sellSetup >= eMinSetup
    label.new(bar_index, setupSellY, f_count(sellSetup, eSetupStyle, "S"), style = label.style_none, textcolor = sellSetupDone ? bearCol : color.new(bearCol, 30), size = size.tiny)

// 13 itself is drawn by the plotshape below, so it is skipped here.
if eShowCD and buyCDPrint >= eMinCD and not buyCD13
    label.new(bar_index, cdBuyY, f_count(buyCDPrint, eCdStyle, "C"), style = label.style_none, textcolor = color.new(cdBullCol, classicMode ? 0 : 20), size = size.tiny)

if eShowCD and sellCDPrint >= eMinCD and not sellCD13
    label.new(bar_index, cdSellY, f_count(sellCDPrint, eCdStyle, "C"), style = label.style_none, textcolor = color.new(cdBearCol, classicMode ? 0 : 20), size = size.tiny)

deferTxt = eCdStyle == "Plain" ? "+" : "C+"
if eShowCD and buyCDDefer
    label.new(bar_index, cdBuyY, deferTxt, style = label.style_none, textcolor = color.new(cdBullCol, classicMode ? 0 : 20), size = size.tiny)

if eShowCD and sellCDDefer
    label.new(bar_index, cdSellY, deferTxt, style = label.style_none, textcolor = color.new(cdBearCol, classicMode ? 0 : 20), size = size.tiny)

plotshape(buySetupDone, "Buy setup 9", shape.triangleup, location.belowbar, bullCol, size = size.tiny)
plotshape(sellSetupDone, "Sell setup 9", shape.triangledown, location.abovebar, bearCol, size = size.tiny)
plotshape(showPerf and buyPerfected, "Buy setup perfected", shape.diamond, location.belowbar, bullCol, size = size.tiny)
plotshape(showPerf and sellPerfected, "Sell setup perfected", shape.diamond, location.abovebar, bearCol, size = size.tiny)
if buyCD13
    label.new(bar_index, cdBuyY, classicMode ? "13" : "CD13", style = label.style_label_up, color = bullCol, textcolor = color.white, size = size.tiny)
if sellCD13
    label.new(bar_index, cdSellY, classicMode ? "13" : "CD13", style = label.style_label_down, color = bearCol, textcolor = color.white, size = size.tiny)

// ------------------------------------------------------------------- alerts --
alertcondition(buySetupDone, "TD buy setup 9", "TD buy setup completed on {{ticker}} {{interval}}")
alertcondition(sellSetupDone, "TD sell setup 9", "TD sell setup completed on {{ticker}} {{interval}}")
alertcondition(buyPerfected, "TD buy setup perfected", "TD buy setup perfected on {{ticker}} {{interval}}")
alertcondition(sellPerfected, "TD sell setup perfected", "TD sell setup perfected on {{ticker}} {{interval}}")
alertcondition(buyCD13, "TD buy countdown 13", "TD buy countdown 13 on {{ticker}} {{interval}}")
alertcondition(sellCD13, "TD sell countdown 13", "TD sell countdown 13 on {{ticker}} {{interval}}")
alertcondition(goLong, "Buy entry", "TD buy entry on {{ticker}} {{interval}} at {{close}}")
alertcondition(goShort, "Sell entry", "TD sell entry on {{ticker}} {{interval}} at {{close}}")
alertcondition(exitStop, "Stopped out", "TD trade stopped out on {{ticker}} {{interval}}")
alertcondition(exitTgt, "Target reached", "TD trade reached TDST target on {{ticker}} {{interval}}")
alertcondition(resBreak, "TDST resistance broken", "Close above TDST resistance on {{ticker}} {{interval}}")
alertcondition(supBreak, "TDST support broken", "Close below TDST support on {{ticker}} {{interval}}")
