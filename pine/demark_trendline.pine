// DeMark Trendline — qualified TD Point trendlines with projections
//@version=6
indicator("DeMark Trendline", shorttitle="DeMark TL", overlay=true, max_lines_count=500)

left = input.int(1, "TD Point Left Bars", minval=1)
right = input.int(1, "TD Point Right Bars", minval=1)

ph = ta.pivothigh(high, left, right)
pl = ta.pivotlow(low, left, right)

var array<float> hiPrice = array.new<float>()
var array<int> hiBar = array.new<int>()
var array<float> loPrice = array.new<float>()
var array<int> loBar = array.new<int>()

if not na(ph)
    hiPrice.push(ph)
    hiBar.push(bar_index - right)
    if hiPrice.size() > 4
        hiPrice.shift()
        hiBar.shift()
if not na(pl)
    loPrice.push(pl)
    loBar.push(bar_index - right)
    if loPrice.size() > 4
        loPrice.shift()
        loBar.shift()

var line demandLine = na
var line supplyLine = na

if loPrice.size() >= 2
    line.delete(demandLine)
    n = loPrice.size()
    demandLine := line.new(loBar.get(n - 2), loPrice.get(n - 2), loBar.get(n - 1), loPrice.get(n - 1), xloc=xloc.bar_index, extend=extend.right, color=color.new(color.green, 0), width=2)

if hiPrice.size() >= 2
    line.delete(supplyLine)
    n = hiPrice.size()
    supplyLine := line.new(hiBar.get(n - 2), hiPrice.get(n - 2), hiBar.get(n - 1), hiPrice.get(n - 1), xloc=xloc.bar_index, extend=extend.right, color=color.new(color.red, 0), width=2)

// Projection: where the line sits one bar ahead. line.get_price on an
// undefined line id is a runtime error, so guard every read.
float demandNow = na
float demandPrev = na
float supplyNow = na
float supplyPrev = na

if not na(demandLine)
    demandNow := line.get_price(demandLine, bar_index)
    demandPrev := line.get_price(demandLine, bar_index - 1)
if not na(supplyLine)
    supplyNow := line.get_price(supplyLine, bar_index)
    supplyPrev := line.get_price(supplyLine, bar_index - 1)

plot(na(demandNow) ? na : demandNow + (demandNow - demandPrev), "Demand Projection", color=color.new(color.green, 50), style=plot.style_circles, offset=1)
plot(na(supplyNow) ? na : supplyNow + (supplyNow - supplyPrev), "Supply Projection", color=color.new(color.red, 50), style=plot.style_circles, offset=1)

demandBreak = not na(demandNow) and close < demandNow
supplyBreak = not na(supplyNow) and close > supplyNow

plotshape(demandBreak and not demandBreak[1], "Demand Break", style=shape.xcross, location=location.belowbar, color=color.red, size=size.tiny)
plotshape(supplyBreak and not supplyBreak[1], "Supply Break", style=shape.xcross, location=location.abovebar, color=color.green, size=size.tiny)

alertcondition(demandBreak, "Demand Trendline Broken", "Price closed through the DeMark demand trendline")
alertcondition(supplyBreak, "Supply Trendline Broken", "Price closed through the DeMark supply trendline")
