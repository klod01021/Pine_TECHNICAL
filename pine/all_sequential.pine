// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// DeMark Sequential Suite — TD Setup, classic Countdown, TD Combo and the
// Ultimate qualifiers on one chart.
//@version=6
indicator("DeMark Sequential Suite", shorttitle="DeM Sequential", overlay=true, timeframe="", timeframe_gaps=true, max_labels_count=500)

setupLen = input.int(9, "Setup Length", minval=1)
cdLen = input.int(13, "Countdown Length", minval=1)
cmp = input.int(4, "Comparison Bars", minval=1)
showCounts = input.bool(true, "Show live setup counts")
showCombo = input.bool(true, "Show Combo 13s")
showUltimate = input.bool(true, "Show Aggressive / Conservative markers")

// ---------------------------------------------------------------------------
// TD Setup (shared by all three countdowns)
// ---------------------------------------------------------------------------
var int buySetup = 0
var int sellSetup = 0
if close < close[cmp]
    buySetup += 1
    sellSetup := 0
else if close > close[cmp]
    sellSetup += 1
    buySetup := 0

if buySetup > setupLen
    buySetup := 1
if sellSetup > setupLen
    sellSetup := 1

// ---------------------------------------------------------------------------
// Classic Countdown
// ---------------------------------------------------------------------------
var int buyCd = 0
var int sellCd = 0
var bool buyCdActive = false
var bool sellCdActive = false
var float buyCd8Close = na
var float sellCd8Close = na
var float buyCdLowest = na
var float sellCdHighest = na

if buySetup == setupLen
    buyCdActive := true
    buyCd := 0
    buyCd8Close := na
    buyCdLowest := na
if sellSetup == setupLen
    sellCdActive := true
    sellCd := 0
    sellCd8Close := na
    sellCdHighest := na

buy13 = false
sell13 = false

if buyCdActive and bar_index >= 2 and close <= low[2]
    buyCd += 1
    if buyCd == 8
        buyCd8Close := close
    buyCdLowest := na(buyCdLowest) ? low : math.min(buyCdLowest, low)
    if buyCd == cdLen
        buy13 := true
        buyCdActive := false

if sellCdActive and bar_index >= 2 and close >= high[2]
    sellCd += 1
    if sellCd == 8
        sellCd8Close := close
    sellCdHighest := na(sellCdHighest) ? high : math.max(sellCdHighest, high)
    if sellCd == cdLen
        sell13 := true
        sellCdActive := false

// ---------------------------------------------------------------------------
// TD Combo Countdown (stricter: marching lows/highs)
// ---------------------------------------------------------------------------
var int buyCombo = 0
var int sellCombo = 0
var bool buyComboActive = false
var bool sellComboActive = false
var float lastBuyLow = na
var float lastSellHigh = na

if buySetup == setupLen
    buyComboActive := true
    buyCombo := 0
    lastBuyLow := na
if sellSetup == setupLen
    sellComboActive := true
    sellCombo := 0
    lastSellHigh := na

buyCombo13 = false
sellCombo13 = false

if buyComboActive and bar_index >= 2 and close <= low[2] and (na(lastBuyLow) or low < lastBuyLow)
    buyCombo += 1
    lastBuyLow := low
    if buyCombo == cdLen
        buyCombo13 := true
        buyComboActive := false

if sellComboActive and bar_index >= 2 and close >= high[2] and (na(lastSellHigh) or high > lastSellHigh)
    sellCombo += 1
    lastSellHigh := high
    if sellCombo == cdLen
        sellCombo13 := true
        sellComboActive := false

// ---------------------------------------------------------------------------
// Ultimate qualifiers on the classic 13
// ---------------------------------------------------------------------------
buyAggressive = buy13 and not na(buyCd8Close) and close <= buyCd8Close
buyConservative = buy13 and low <= buyCdLowest
sellAggressive = sell13 and not na(sellCd8Close) and close >= sellCd8Close
sellConservative = sell13 and high >= sellCdHighest

// ---------------------------------------------------------------------------
// Plots
// ---------------------------------------------------------------------------
plotshape(buySetup == setupLen, "Buy 9", style=shape.labelup, location=location.belowbar, color=color.green, text="9", textcolor=color.white, size=size.tiny)
plotshape(sellSetup == setupLen, "Sell 9", style=shape.labeldown, location=location.abovebar, color=color.red, text="9", textcolor=color.white, size=size.tiny)
plotshape(buy13, "Buy 13", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.small)
plotshape(sell13, "Sell 13", style=shape.triangledown, location=location.abovebar, color=color.maroon, size=size.small)
plotshape(showCombo and buyCombo13, "Combo Buy 13", style=shape.diamond, location=location.belowbar, color=color.aqua, size=size.small)
plotshape(showCombo and sellCombo13, "Combo Sell 13", style=shape.diamond, location=location.abovebar, color=color.fuchsia, size=size.small)
plotshape(showUltimate and buyConservative, "Buy 13 Conservative", style=shape.circle, location=location.belowbar, color=color.blue, size=size.tiny)
plotshape(showUltimate and sellConservative, "Sell 13 Conservative", style=shape.circle, location=location.abovebar, color=color.orange, size=size.tiny)

if showCounts and buySetup > 0 and buySetup < setupLen
    label.new(bar_index, low, str.tostring(buySetup), xloc=xloc.bar_index, style=label.style_label_up, color=color.new(color.green, 100), textcolor=color.new(color.green, 40), size=size.tiny)
if showCounts and sellSetup > 0 and sellSetup < setupLen
    label.new(bar_index, high, str.tostring(sellSetup), xloc=xloc.bar_index, style=label.style_label_down, color=color.new(color.red, 100), textcolor=color.new(color.red, 40), size=size.tiny)

alertcondition(buy13, "Buy 13", "Classic buy countdown completed")
alertcondition(sell13, "Sell 13", "Classic sell countdown completed")
alertcondition(buyCombo13, "Combo Buy 13", "Combo buy countdown completed")
alertcondition(sellCombo13, "Combo Sell 13", "Combo sell countdown completed")
