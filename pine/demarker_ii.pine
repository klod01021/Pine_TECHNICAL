// DeMarker II — close/midpoint variant of the DeMarker
//@version=6
indicator("DeMarker II", shorttitle="DeM II", overlay=false)

length = input.int(8, "Length", minval=1)
overbought = input.float(70.0, "Overbought")
oversold = input.float(30.0, "Oversold")

midpoint = (high + low) / 2.0
upside = math.max(high - midpoint, 0.0) * (close >= midpoint ? 1.0 : 0.0)
downside = math.max(midpoint - low, 0.0) * (close < midpoint ? 1.0 : 0.0)

sumUp = ta.sma(upside, length)
sumDown = ta.sma(downside, length)

dem2 = (sumUp + sumDown) == 0.0 ? 0.0 : 100.0 * sumUp / (sumUp + sumDown)

plot(dem2, "DeMarker II", color=color.new(color.blue, 0), linewidth=2)
plot(overbought, "Overbought", color=color.new(color.red, 40))
plot(oversold, "Oversold", color=color.new(color.green, 40))
hline(50, "Mid", color=color.new(color.gray, 60))

bgcolor(dem2 > overbought ? color.new(color.red, 90) : dem2 < oversold ? color.new(color.green, 90) : na)
